#!/usr/bin/env bash

show_help() {
    cat << EOF
Usage:
  $(basename "$0") [options] <input.pdf>

Description:
  Split a PDF into individual pages using Ghostscript.

Options:
  -q QUALITY   Compression quality preset
  -f NAME      Base output filename
  -h           Show this help message

Quality presets:
  screen       Lowest quality, smallest size (~72 DPI)
  ebook        Medium quality (~150 DPI) [default]
  printer      High quality (~300 DPI)
  prepress     Very high quality for print
  default      Ghostscript default settings

Examples:
  $(basename "$0") document.pdf
  $(basename "$0") -q screen document.pdf
  $(basename "$0") -q printer -f page document.pdf

Output:
  page-001.pdf
  page-002.pdf
  ...

EOF
}

quality="ebook"
basename_override=""

while getopts ":q:f:h" opt; do
    case "$opt" in
        q)
            quality="$OPTARG"
            ;;
        f)
            basename_override="$OPTARG"
            ;;
        h)
            show_help
            exit 0
            ;;
        \?)
            echo "Error: Invalid option -$OPTARG"
            echo
            show_help
            exit 1
            ;;
        :)
            echo "Error: Option -$OPTARG requires an argument"
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

input="$1"

if [[ -z "$input" ]]; then
    echo "Error: No input PDF specified"
    echo
    show_help
    exit 1
fi

if [[ ! -f "$input" ]]; then
    echo "Error: File not found: $input"
    exit 1
fi

case "$quality" in
    screen|ebook|printer|prepress|default)
        ;;
    *)
        echo "Error: Invalid quality preset: $quality"
        echo "Valid presets: screen, ebook, printer, prepress, default"
        exit 1
        ;;
esac

if [[ -n "$basename_override" ]]; then
    base="$basename_override"
else
    base="${input%.pdf}"
fi

gs \
  -sDEVICE=pdfwrite \
  -dCompatibilityLevel=1.4 \
  -dPDFSETTINGS="/$quality" \
  -dNOPAUSE \
  -dBATCH \
  -dSAFER \
  -sOutputFile="${base}-%03d.pdf" \
  "$input"
